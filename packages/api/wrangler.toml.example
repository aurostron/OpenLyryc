name = "openlyryc-core"
main = "src/index.ts"
compatibility_date = "2024-08-01"

# Cloudflare account_id is automatically detected with `npx wrangler login`.
# Optionally specify your account ID:
# account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

[[d1_databases]]
binding = "DB"
database_name = "openlyryc-db"
database_id = "YOUR_D1_DATABASE_ID"

[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "YOUR_KV_NAMESPACE_ID"

# [vars]
# TURNSTILE_SECRET = "YOUR_TURNSTILE_SECRET"
